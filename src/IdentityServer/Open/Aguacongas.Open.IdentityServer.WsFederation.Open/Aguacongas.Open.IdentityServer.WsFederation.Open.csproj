<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Authors>Olivier Lefebvre</Authors>
		<Description>Add WS-Federation controller to your Open.IdentityServer server.</Description>
		<Copyright>Copyright (c) 2026 @Olivier Lefebvre</Copyright>
		<PackageProjectUrl>https://github.com/Aguafrommars/FreeTheIdServer/tree/master/src/IdentityServer/Aguacongas.Open.IdentityServer.WsFederation</PackageProjectUrl>
		<RepositoryUrl>https://github.com/aguacongas/FreeTheIdServer</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageTags>FreeTheIdServer;Open.IdentityServer;ws-federation</PackageTags>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<PackageIcon>package-icon.png</PackageIcon>
		<PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
		<PackageReadmeFile>README.md</PackageReadmeFile>

    <EnablePreviewFeatures>True</EnablePreviewFeatures>
	</PropertyGroup>

	<ItemGroup>
		<None Update="README.md">
			<PackagePath>\</PackagePath>
			<Pack>True</Pack>
		</None>
	</ItemGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
		<DefineConstants>$(DefineConstants)TRACE</DefineConstants>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
		<DefineConstants>$(DefineConstants)TRACE</DefineConstants>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\Aguacongas.Open.IdentityServer.WsFederation\Aguacongas.Open.IdentityServer.WsFederation.csproj" />
		<ProjectReference Include="..\Aguacongas.Open.IdentityServer.Open\Aguacongas.Open.IdentityServer.Open.csproj" />
		<ProjectReference Include="..\Aguacongas.Open.IdentityServer.KeysRotation.Open\Aguacongas.Open.IdentityServer.KeysRotation.Open.csproj" />
	</ItemGroup>

	<ItemGroup>
		<None Include="package-icon.png" Pack="true" PackagePath="" />
	</ItemGroup>
</Project>

