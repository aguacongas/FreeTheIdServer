<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Authors>Olivier Lefebvre</Authors>
		<Description>FreeTheIdServer base classes for Open.IdentityServer.</Description>
		<Copyright>Copyright (c) 2026 @Olivier Lefebvre</Copyright>
		<PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
		<PackageProjectUrl>https://github.com/Aguafrommars/FreeTheIdServer/tree/master/src/IdentityServer/Aguacongas.Open.IdentityServer</PackageProjectUrl>
		<RepositoryUrl>https://github.com/Aguafrommars/FreeTheIdServer</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageTags>FreeTheIdServer;duede.identityserver</PackageTags>
		<Description>FreeTheIdServer IndentityServer4 abstraction and extensions.</Description>
		<DebugType>portable</DebugType>
		<PackageIcon>package-icon.png</PackageIcon>
		<RootNamespace>Aguacongas.Open.IdentityServer</RootNamespace>
    <EnablePreviewFeatures>True</EnablePreviewFeatures>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
	  <DefineConstants>$(DefineConstants)TRACE</DefineConstants>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
	  <DefineConstants>$(DefineConstants)TRACE</DefineConstants>
	</PropertyGroup>

	<ItemGroup>
		<Folder Include="Absractions\" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\Aguacongas.Open.IdentityServer\Aguacongas.Open.IdentityServer.csproj" />
	</ItemGroup>
	<ItemGroup>
		<None Include="package-icon.png" />
	</ItemGroup>
	<ItemGroup>
	  <PackageReference Include="Open.IdentityServer" Version="2.0.0" />
	</ItemGroup>

	<ItemGroup>
		<None Include="package-icon.png" Pack="true" PackagePath="" />
	</ItemGroup>

</Project>

