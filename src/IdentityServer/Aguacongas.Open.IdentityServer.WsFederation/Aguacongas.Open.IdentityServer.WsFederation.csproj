<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Authors>Olivier Lefebvre</Authors>
		<Description>WS-Federation controller classes.</Description>
		<Copyright>Copyright (c) 2026 @Olivier Lefebvre</Copyright>
		<PackageProjectUrl>https://github.com/aguacongas/FreeTheIdServer/tree/master/src/IdentityServer/Aguacongas.Open.IdentityServer.WsFederation</PackageProjectUrl>
		<RepositoryUrl>https://github.com/aguacongas/FreeTheIdServer</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageTags>FreeTheIdServer;ws-federation</PackageTags>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<PackageIcon>package-icon.png</PackageIcon>
		<PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
		<IsPackable>true</IsPackable>
		<OutputType>Library</OutputType>
		<IsPackable>true</IsPackable>
		<PackageReadmeFile>README.md</PackageReadmeFile>
	</PropertyGroup>

	<ItemGroup>
		<None Update="README.md">
			<PackagePath>\</PackagePath>
			<Pack>True</Pack>
		</None>
	</ItemGroup>

	<ItemGroup>
	  <Compile Remove="Validation\**" />
	  <EmbeddedResource Remove="Validation\**" />
	  <None Remove="Validation\**" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.IdentityModel.Protocols.WsFederation" Version="8.22.0" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Aguacongas.Open.IdentityServer.KeysRotation\Aguacongas.Open.IdentityServer.KeysRotation.csproj" />
		<ProjectReference Include="..\Aguacongas.Open.IdentityServer.Store\Aguacongas.Open.IdentityServer.Store.csproj" />
	</ItemGroup>
	<ItemGroup>
		<None Include="package-icon.png" Pack="true" PackagePath="" />
	</ItemGroup>
	<ItemGroup>
	  <None Update="README.md">
	    <PackagePath>\</PackagePath>
	    <Pack>True</Pack>
	  </None>
	</ItemGroup>
</Project>

