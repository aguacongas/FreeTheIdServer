<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<RootNamespace>Aguacongas.FreeTheIdServer.PostgreSQL</RootNamespace>
		<Authors>Olivier Lefebvre</Authors>
		<Copyright>Copyright (c) 2026 @Olivier Lefebvre</Copyright>
		<PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
		<PackageProjectUrl>https://github.com/aguacongas/FreeTheIdServer/tree/master/src/Aguacongas.FreeTheIdServer</PackageProjectUrl>
		<RepositoryUrl>https://github.com/aguacongas/FreeTheIdServer</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageTags>FreeTheIdServer;postgresql</PackageTags>
		<Description>Contains db contexts migrations code for PostgreSQL.</Description>		
		<PackageIcon>package-icon.png</PackageIcon>
    <EnablePreviewFeatures>True</EnablePreviewFeatures>
	</PropertyGroup>

	<ItemGroup>
		<None Remove="THIRD-PARTY-NOTICES" />
	</ItemGroup>

	<ItemGroup>
		<Content Include="THIRD-PARTY-NOTICES">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>Never</CopyToPublishDirectory>
		</Content>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Identity.Client" Version="4.92.0" />
		<PackageReference Include="MongoDB.Driver" Version="3.13.0" />
		<PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.14" />
		<PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.14" />
		<PackageReference Include="StackExchange.Redis" Version="3.4.20" />
		<PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.23.0" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\Aguacongas.Open.IdentityServer.EntityFramework.Store\Aguacongas.Open.IdentityServer.EntityFramework.Store.csproj" />
	</ItemGroup>
	<ItemGroup>
		<None Include="package-icon.png" Pack="true" PackagePath="" />
	</ItemGroup>

</Project>
