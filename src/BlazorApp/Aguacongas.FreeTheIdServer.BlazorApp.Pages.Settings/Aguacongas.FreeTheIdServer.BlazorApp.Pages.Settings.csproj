<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Authors>Olivier Lefebvre</Authors>
    <Copyright>Copyright (c) 2026 @Olivier Lefebvre</Copyright>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/aguacongas/FreeTheIdServer/tree/master/src/Aguacongas.FreeTheIdServer.BlazorApp</PackageProjectUrl>
    <RepositoryUrl>https://github.com/aguacongas/FreeTheIdServer</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>FreeTheIdServer;identityserver4;Open-identityserveroidc;oauth;identity,authentication;security</PackageTags>
    <Description>FreeTheIdServer settings page.</Description>
    <DebugType>portable</DebugType>
    <PackageIcon>package-icon.png</PackageIcon>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorWebAssemblyLazyLoad>true</BlazorWebAssemblyLazyLoad>
  </PropertyGroup>


	<ItemGroup>
		<SupportedPlatform Include="browser" />
	</ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.10" />
  </ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Aguacongas.FreeTheIdServer.BlazorApp.Infrastructure\Aguacongas.FreeTheIdServer.BlazorApp.Infrastructure.csproj" />
	</ItemGroup>

	<ItemGroup>
		<None Include="package-icon.png" Pack="true" PackagePath="" />
	</ItemGroup>
</Project>

